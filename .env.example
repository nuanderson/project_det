# Copie as variáveis necessárias para o ambiente do servidor (o projeto lê direto do ambiente).
DET_DEBUG=False
DET_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
DET_ALLOWED_HOSTS=det.instituto.exemplo
DET_CSRF_TRUSTED_ORIGINS=https://det.instituto.exemplo

# Banco: sqlite (padrão) ou postgresql
DET_DB_ENGINE=sqlite
# DET_DB_NAME=det
# DET_DB_USER=det
# DET_DB_PASSWORD=
# DET_DB_HOST=localhost

# Anexos (fora de pasta pública) e limite de tamanho em MB
DET_MEDIA_ROOT=D:\dados\det_anexos
DET_ANEXO_MAX_MB=10

# E-mail (sem DET_EMAIL_HOST os e-mails vão para o console)
# DET_EMAIL_HOST=smtp.instituto.exemplo
# DET_EMAIL_PORT=587
# DET_EMAIL_USER=
# DET_EMAIL_PASSWORD=
# DET_EMAIL_FROM=det-controle@instituto.exemplo

# Alertas: dia do mês do lembrete e dias antes do prazo
DET_ALERTA_DIA_MES=5
DET_ALERTA_DIAS_PRAZO=5,2
